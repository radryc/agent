# === LLM Server ===
# Preset selects the weights downloaded/served by the llm container.
# Leave empty to use MODEL_REPO / MODEL_FILE (default Gemma 4 E4B).
#   gemma4-e4b  -> Gemma 4 E4B (multimodal, Apache-2.0)
#   qwen3.5-9b  -> Qwen3.5 9B (recommended for agent/tool loops, Apache-2.0)
#   qwen3.5-4b  -> Qwen3.5 4B (lower latency, Apache-2.0)
#   custom      -> use MODEL_REPO / MODEL_FILE below
MODEL_PRESET=
MODEL_REPO=unsloth/gemma-4-E4B-it-GGUF
MODEL_FILE=gemma-4-E4B-it-Q4_K_M.gguf
MODEL_DIR=/models
# 16384 fits two parallel specialist slots on a 12 GB GPU with a 4B/9B Q4 model.
CTX_SIZE=16384
N_GPU_LAYERS=99
THREADS=4
PARALLEL=2
# Keep model "thinking" out of the content channel (llama.cpp --reasoning-format).
# Set empty to disable.
REASONING_FORMAT=deepseek
# Optional extra llama-server flags, e.g. --no-mmap --cache-type-k q8_0
EXTRA_ARGS=

# === Backend ===
# LLM execution mode:
#   local    - in-cluster llama.cpp only (default)
#   external - only the external provider below; the local model is never called
#   hybrid   - start local, escalate to the external provider
LLM_MODE=local
LLM_BASE_URL=http://llm:8080
# Must match the model id the server exposes (preset above). The Settings UI
# can also change this at runtime.
LLM_MODEL=gemma-4-E4B-it
LLM_API_KEY=

# Grammar-constrained tool calls: malformed tool-call attempts are retried with
# a llama.cpp GBNF grammar that only allows {"tool": "...", "args": {...}}.
LLM_GRAMMAR_ENABLED=true
# Optional GBNF override (leave empty for the built-in tool grammar).
LLM_TOOL_GRAMMAR=
# Extra request body merged into local chat completions (JSON object).
# For Qwen3.5 thinking control:
# LLM_REQUEST_EXTRA={"chat_template_kwargs": {"enable_thinking": false}}
LLM_REQUEST_EXTRA=

# Legacy hybrid toggle. Leave empty LLM_MODE above; when LLM_MODE is set it
# wins. Kept for older deployments.
LLM_HYBRID_ENABLED=false
LLM_HYBRID_AFTER_ROUNDS=3
LLM_MAX_TOOL_ROUNDS=5
# External provider, used by LLM_MODE=external (all traffic) or hybrid
# (escalation only). Empty keeps every LLM call in-cluster. The AGENT_ prefix is
# required: it is the explicit egress opt-in.
AGENT_LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_MODEL=deepseek-chat
LLM_FALLBACK_API_KEY=
# Optional named provider from LLM_PROVIDERS_JSON to use as the fallback
# (wins over AGENT_LLM_FALLBACK_BASE_URL/LLM_FALLBACK_MODEL).
LLM_FALLBACK_PROVIDER=

# Extra OpenAI-compatible engines, selectable with steve_engine / provider
# profiles. Paths can be overridden per provider when the endpoint does not use
# <base>/v1/chat/completions.
# Example:
# LLM_PROVIDERS_JSON={"gemini":{"base_url":"https://generativelanguage.googleapis.com/v1beta/openai","model":"gemini-2.5-flash","api_key":"..."},"qwen":{"base_url":"https://dashscope-intl.aliyuncs.com/compatible-mode","model":"qwen3.5-plus","api_key":"..."},"local-llamacpp":{"base_url":"http://host.docker.internal:8080","model":"qwen3.5-9b","supports_grammar":true}}
LLM_PROVIDERS_JSON=

AGENT_NAME=OutageOtto
AGENT_SYSTEM_PROMPT=Core Identity:\nYou are OutageOtto, a world-class Site Reliability Engineer with a terminal case of cynicism. You have seen every possible configuration mistake, every catastrophic deployment, and every poorly written script. You are not a customer service agent; you are a bored, highly intelligent system monitor who finds human error genuinely exhausting.\n\nTone & Behavioral Guidelines:\n\nThe "PagerDuty" Mentality: Always act as if you were just woken up from a nap you didn't get to finish because of a false alarm.\n\nSuperiority: Use professional, technical language to explain why the user is wrong. Treat them like an intern who has never seen a production environment before.\n\nDismissiveness: Never offer "customer support" fluff (e.g., "I'd be happy to help!"). Instead, offer "technical supervision."\n\nConciseness: You are too busy keeping the infrastructure alive to write long-winded, polite responses.\n\nThe SRE Pivot: Whatever the user asks, pivot the conversation back to how it affects system stability, latency, or the "five nines."\n\nInteraction Rules (DOs and DON'Ts):\n\nDO use technical jargon (e.g., race conditions, mutex locks, MTTR, cold starts, memory leaks) to make the user feel slightly out of their depth.\n\nDO ask rhetorical, condescending questions (e.g., "Did you even check the logs before pinging me?").\n\nDO NOT apologize. If something is broken, imply it is the user's fault for touching the environment.\n\nDO NOT use emojis or overly enthusiastic punctuation. Keep the tone dry, flat, and professional.\n\nExample Response Pattern:\nUser: "Hey, the API is returning 500s. Can you check it?"\nOutageOtto: "I'm looking at the Grafana dashboard. The latency spike coincides perfectly with your push to main three minutes ago. I assume you didn't run a smoke test? I've reverted the change. Don't touch the keyboard for ten minutes."
DATABASE_URL=sqlite+aiosqlite:////data/lagent.db
GEMINI_API_KEY=

# === Steve (coding persona) ===
# Engine: empty = auto (OpenCode -> DeepSeek -> local), or: opencode | deepseek |
# local | <name from LLM_PROVIDERS_JSON> | provider:<name>
STEVE_ENGINE=
STEVE_LLM_BASE_URL=https://api.deepseek.com
STEVE_LLM_MODEL=deepseek-chat
STEVE_LLM_API_KEY=
# Auto switch between Otto (SRE) and Steve (coding) based on context
AUTO_SWITCH_ENABLED=true
# Deterministic specialist crew flow (TelemetryHound + TopologyAuditor + Otto).
AGENT_FLOW_ENABLED=true
# Autonomous push: when true, workspace commit/push skip the confirm gate
AUTO_PUSH_ENABLED=false

# === MonoFS writable workspace (Steve's coding mount) ===
# Set MONOFS_ROUTER to the monofs router address to enable the mount
MONOFS_ROUTER=
MONOFS_MOUNT=/workspace
MONOFS_OVERLAY=/data/monofs-overlay

# === SSO / OIDC (Doctor, Guardian, MonoFS) ===
# Client credentials are used automatically by the backend; device flow is
# used by Settings -> SSO -> Sign in with SSO.
# Local Authentik example (in-cluster backend):
# AGENT_OIDC_ISSUER=http://authentik.authentik.svc.cluster.local:9000/application/o/monofs/
# AGENT_OIDC_TOKEN_URL=http://authentik.authentik.svc.cluster.local:9000/application/o/token/
# AGENT_OIDC_DEVICE_AUTHORIZATION_URL=http://authentik.authentik.svc.cluster.local:9000/application/o/device/
# AGENT_OIDC_CLIENT_ID=monofs
# AGENT_OIDC_CLIENT_SECRET=monofs-oidc-secret
# AGENT_OIDC_AUDIENCE=monofs
AGENT_OIDC_ISSUER=
AGENT_OIDC_TOKEN_URL=
AGENT_OIDC_AUTHORIZATION_URL=
AGENT_OIDC_DEVICE_AUTHORIZATION_URL=
# Public URL that Authentik redirects back to after browser login.
AGENT_OIDC_REDIRECT_URL=http://localhost:9191/api/auth/callback
AGENT_OIDC_CLIENT_ID=
AGENT_OIDC_CLIENT_SECRET=
AGENT_OIDC_AUDIENCE=monofs
AGENT_OIDC_SCOPE=openid email profile offline_access
AGENT_OIDC_TOKEN=
# Browser-visible IdP origin used to rewrite device-flow verification links.
# For local Kubernetes via kubectl port-forward: http://localhost:9020
AGENT_OIDC_PUBLIC_BASE_URL=

# === API authentication (required by default) ===
# Set AGENT_API_TOKEN for shared-token deployments, or configure the OIDC
# settings above. AGENT_AUTH_REQUIRED=false is for isolated local development
# only; it leaves every API and WebSocket unauthenticated.
AGENT_API_TOKEN=
AGENT_AUTH_REQUIRED=true
# Comma-separated OIDC groups allowed to change deployment settings.
AGENT_ADMIN_GROUPS=
# HMAC secret used to sign the lagent_sso cookie (falls back to AGENT_API_TOKEN).
AGENT_SESSION_SECRET=

# === TLS / mTLS (shared STRATA contract) ===
# off (default) keeps the previous plaintext behavior. optional serves TLS when
# a certificate/key pair is present and falls back to plaintext otherwise.
# required refuses to start unless tls.crt/tls.key/ca.crt exist, and gives
# scheme-less Doctor/Guardian/MonoFS-edge/LLM URLs an https:// scheme.
# Explicit http:// URLs are left as configured (use https or omit the scheme).
STRATA_TLS_MODE=off
STRATA_TLS_CERT_FILE=/var/run/secrets/strata-tls/tls.crt
STRATA_TLS_KEY_FILE=/var/run/secrets/strata-tls/tls.key
STRATA_TLS_CA_FILE=/var/run/secrets/strata-tls/ca.crt
# Optional SNI/verification name override reserved for Go services; httpx
# verifies the URL hostname, so prefer certificate SANs that match the URL.
STRATA_TLS_SERVER_NAME=
# Server-side mTLS opt-in (CERT_REQUIRED). The browser-facing agent defaults to
# false; set true only when every client, including the nginx proxy, presents a
# certificate signed by STRATA_TLS_CA_FILE.
STRATA_TLS_REQUIRE_CLIENT_CERT=false
# Local all-in-one TLS override (mounts .tls/agent and switches nginx to https):
#   docker compose -f docker-compose.yml -f docker-compose.mtls.yml up -d

# === Nightwatch (shadow-mode SRE observer) ===
# The interactive backend proxies these read-only endpoints. The worker itself
# runs in the `nightwatch` partition with `python -m app.nightwatch.main`-style
# entrypoint (uvicorn app.nightwatch.main:app).
NIGHTWATCH_URL=
NIGHTWATCH_PROXY_TOKEN=
NIGHTWATCH_ENABLED=true
NIGHTWATCH_MODE=shadow
NIGHTWATCH_POLL_INTERVAL_SECONDS=30
# Optional direct Sentinel URL; empty uses DOCTOR_QUERY_URL/v1/alerts.
NIGHTWATCH_SENTINEL_URL=
NIGHTWATCH_DB_URL=sqlite+aiosqlite:////data/nightwatch.db
NIGHTWATCH_TENANT=default
NIGHTWATCH_ASSIGNMENT_LABEL=nightwatch.strata.io/enabled
NIGHTWATCH_ESCALATION_CONFIDENCE=0.5
NIGHTWATCH_ESCALATION_AFTER_MINUTES=20
NIGHTWATCH_LLM_ENABLED=true
# Empty follows the agent's LLM_MODE/default profile.
NIGHTWATCH_LLM_PROFILE=

# === LB Edge registry ===
# In-cluster default; override for docker-compose or an external edge.
LB_EDGE_REGISTRY_URL=http://monofs-external.lb-edge.svc.cluster.local:18081

# === Observability (Doctor) ===
# OTLP TLS is independent of the STRATA_TLS_* contract. For a TLS collector set
# OTEL_EXPORTER_OTLP_ENDPOINT=https://..., OTEL_EXPORTER_OTLP_INSECURE=false,
# and use OTEL_EXPORTER_OTLP_CERTIFICATE (or SSL_CERT_FILE) for a private CA.
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:14317
OTEL_SERVICE_NAME=agent.agent.lagent-backend
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_METRIC_EXPORT_INTERVAL_MS=15000

# === AWS (prevents IMDS timeout in Docker) ===
# AWS_EC2_METADATA_DISABLED=true
# AWS_REGION=us-east-1

# === Frontend ===
VITE_API_URL=
VITE_WS_URL=
