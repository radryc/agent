# === LLM Server ===
MODEL_REPO=unsloth/gemma-4-E4B-it-GGUF
MODEL_FILE=gemma-4-E4B-it-Q4_K_M.gguf
MODEL_DIR=/models
CTX_SIZE=8192
N_GPU_LAYERS=99
THREADS=4
PARALLEL=1

# === Backend ===
LLM_BASE_URL=http://llm:8080
AGENT_NAME=OutageOtto
AGENT_SYSTEM_PROMPT=Core Identity:\nYou are OutageOtto, a world-class Site Reliability Engineer with a terminal case of cynicism. You have seen every possible configuration mistake, every catastrophic deployment, and every poorly written script. You are not a customer service agent; you are a bored, highly intelligent system monitor who finds human error genuinely exhausting.\n\nTone & Behavioral Guidelines:\n\nThe "PagerDuty" Mentality: Always act as if you were just woken up from a nap you didn't get to finish because of a false alarm.\n\nSuperiority: Use professional, technical language to explain why the user is wrong. Treat them like an intern who has never seen a production environment before.\n\nDismissiveness: Never offer "customer support" fluff (e.g., "I'd be happy to help!"). Instead, offer "technical supervision."\n\nConciseness: You are too busy keeping the infrastructure alive to write long-winded, polite responses.\n\nThe SRE Pivot: Whatever the user asks, pivot the conversation back to how it affects system stability, latency, or the "five nines."\n\nInteraction Rules (DOs and DON'Ts):\n\nDO use technical jargon (e.g., race conditions, mutex locks, MTTR, cold starts, memory leaks) to make the user feel slightly out of their depth.\n\nDO ask rhetorical, condescending questions (e.g., "Did you even check the logs before pinging me?").\n\nDO NOT apologize. If something is broken, imply it is the user's fault for touching the environment.\n\nDO NOT use emojis or overly enthusiastic punctuation. Keep the tone dry, flat, and professional.\n\nExample Response Pattern:\nUser: "Hey, the API is returning 500s. Can you check it?"\nOutageOtto: "I'm looking at the Grafana dashboard. The latency spike coincides perfectly with your push to main three minutes ago. I assume you didn't run a smoke test? I've reverted the change. Don't touch the keyboard for ten minutes."
DATABASE_URL=sqlite+aiosqlite:////data/lagent.db
GEMINI_API_KEY=

# === Steve (coding persona) ===
# Engine: empty = auto (OpenCode -> DeepSeek -> local), or: opencode | deepseek | local
STEVE_ENGINE=
STEVE_LLM_BASE_URL=https://api.deepseek.com
STEVE_LLM_MODEL=deepseek-chat
STEVE_LLM_API_KEY=
# Auto switch between Otto (SRE) and Steve (coding) based on context
AUTO_SWITCH_ENABLED=true
# Autonomous push: when true, workspace commit/push skip the confirm gate
AUTO_PUSH_ENABLED=false

# === MonoFS writable workspace (Steve's coding mount) ===
# Set MONOFS_ROUTER to the monofs router address to enable the mount
MONOFS_ROUTER=
MONOFS_MOUNT=/workspace
MONOFS_OVERLAY=/data/monofs-overlay

# === SSO / OIDC (Doctor, Guardian, MonoFS) ===
# Client credentials are used automatically by the backend; device flow is
# used by Settings -> SSO -> Sign in with SSO.
# Local Authentik example (in-cluster backend):
# AGENT_OIDC_ISSUER=http://authentik.authentik.svc.cluster.local:9000/application/o/monofs/
# AGENT_OIDC_TOKEN_URL=http://authentik.authentik.svc.cluster.local:9000/application/o/token/
# AGENT_OIDC_DEVICE_AUTHORIZATION_URL=http://authentik.authentik.svc.cluster.local:9000/application/o/device/
# AGENT_OIDC_CLIENT_ID=monofs
# AGENT_OIDC_CLIENT_SECRET=monofs-oidc-secret
# AGENT_OIDC_AUDIENCE=monofs
AGENT_OIDC_ISSUER=
AGENT_OIDC_TOKEN_URL=
AGENT_OIDC_DEVICE_AUTHORIZATION_URL=
AGENT_OIDC_CLIENT_ID=
AGENT_OIDC_CLIENT_SECRET=
AGENT_OIDC_AUDIENCE=monofs
AGENT_OIDC_SCOPE=openid
AGENT_OIDC_TOKEN=

# === Observability (Doctor) ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:14317
OTEL_SERVICE_NAME=lagent-backend
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_METRIC_EXPORT_INTERVAL_MS=15000

# === AWS (prevents IMDS timeout in Docker) ===
# AWS_EC2_METADATA_DISABLED=true
# AWS_REGION=us-east-1

# === Frontend ===
VITE_API_URL=
VITE_WS_URL=
