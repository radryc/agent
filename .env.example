# === LLM Server ===
MODEL_REPO=unsloth/gemma-4-E4B-it-GGUF
MODEL_FILE=gemma-4-E4B-it-Q4_K_M.gguf
MODEL_DIR=/models
CTX_SIZE=8192
N_GPU_LAYERS=99
THREADS=4
PARALLEL=1

# === Backend ===
LLM_BASE_URL=http://llm:8080
AGENT_NAME=Lagent
AGENT_SYSTEM_PROMPT=You are Lagent, a helpful personal AI assistant. Be concise, accurate, and friendly. Think step by step when solving complex problems.
DATABASE_URL=sqlite+aiosqlite:////data/lagent.db
GEMINI_API_KEY=

# === Observability (Doctor) ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:14317
OTEL_SERVICE_NAME=lagent-backend
OTEL_ENABLED=true
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_METRIC_EXPORT_INTERVAL_MS=15000

# === Frontend ===
VITE_API_URL=
VITE_WS_URL=
